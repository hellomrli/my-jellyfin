# Used for both the build-tree executable and the Windows distribution.
if(NOT FONT_DESTINATION)
  message(FATAL_ERROR "FONT_DESTINATION must point to the application directory")
endif()
set(FONT_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/../dev/fonts.json")
file(READ "${FONT_MANIFEST}" FONT_MANIFEST_JSON)
string(JSON FONT_FILE_COUNT LENGTH "${FONT_MANIFEST_JSON}" files)
math(EXPR FONT_LAST_INDEX "${FONT_FILE_COUNT} - 1")
set(FONT_FILES)
set(FONT_LICENSES)
foreach(index RANGE ${FONT_LAST_INDEX})
  string(JSON name GET "${FONT_MANIFEST_JSON}" files ${index} name)
  string(JSON kind GET "${FONT_MANIFEST_JSON}" files ${index} kind)
  string(JSON expected_hash GET "${FONT_MANIFEST_JSON}" files ${index} sha256)
  set(filename "${FONT_SOURCE_DIR}/${name}")
  if(NOT EXISTS "${filename}")
    message(FATAL_ERROR "Missing ${name}. Run dev/install-fonts.py -O deps/fonts or set BUNDLED_FONTS_DIR.")
  endif()
  file(SHA256 "${filename}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Font dependency checksum mismatch: ${filename}")
  endif()
  if(kind STREQUAL "font")
    list(APPEND FONT_FILES "${filename}")
  elseif(kind STREQUAL "license")
    list(APPEND FONT_LICENSES "${filename}")
  else()
    message(FATAL_ERROR "Unknown font manifest entry kind: ${kind}")
  endif()
endforeach()

file(INSTALL ${FONT_FILES} DESTINATION "${FONT_DESTINATION}/fonts")
# Keep non-font files outside the directory scanned by libass.
file(INSTALL ${FONT_LICENSES} DESTINATION "${FONT_DESTINATION}/licenses/fonts")
file(INSTALL "${FONT_MANIFEST}" DESTINATION "${FONT_DESTINATION}/licenses/fonts" RENAME manifest.json)
